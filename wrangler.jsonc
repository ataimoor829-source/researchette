{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "researchette",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "researchette-db",
      "database_id": "963c8eea-6d00-440e-ba3f-f058143bc8bd"
    }
  ],
  "observability": { "enabled": true }
}
